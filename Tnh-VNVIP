local pages={}
local tabs={}

local function page()
	local p=Instance.new("Frame")
	p.Size=UDim2.fromScale(1,1)
	p.BackgroundTransparency=1
	p.Visible=false
	p.Parent=content
	table.insert(pages,p)
	return p
end

local function tab(txt,y,p)
	local b=Instance.new("TextButton")
	b.Size=UDim2.new(1,-10,0,58)
	b.Position=UDim2.fromOffset(5,y)
	b.BackgroundColor3=Color3.fromRGB(34,40,44)
	b.Text=txt
	b.TextColor3=Color3.new(1,1,1)
	b.TextSize=17
	b.Font=Enum.Font.GothamMedium
	b.Parent=side
	corner(b,10)

	table.insert(tabs,b)

	b.MouseButton1Click:Connect(function()
		for _,v in ipairs(pages) do
			v.Visible=false
		end
		for _,v in ipairs(tabs) do
			v.BackgroundColor3=Color3.fromRGB(34,40,44)
		end
		p.Visible=true
		b.BackgroundColor3=Color3.fromRGB(0,160,225)
	end)

	return b
end

local function button(p,txt,y)
	local b=Instance.new("TextButton")
	b.Size=UDim2.new(1,-10,0,70)
	b.Position=UDim2.fromOffset(5,y)
	b.BackgroundColor3=Color3.fromRGB(27,34,38)
	b.Text=txt
	b.TextColor3=Color3.new(1,1,1)
	b.TextSize=18
	b.TextXAlignment=Enum.TextXAlignment.Left
	b.Font=Enum.Font.GothamMedium
	b.Parent=p
	corner(b,12)
	stroke(b)
	return b
end

local function label(p,txt,y)
	local l=Instance.new("TextLabel")
	l.Size=UDim2.new(1,-10,0,42)
	l.Position=UDim2.fromOffset(5,y)
	l.BackgroundTransparency=1
	l.Text=txt
	l.TextColor3=Color3.new(1,1,1)
	l.TextSize=24
	l.TextXAlignment=Enum.TextXAlignment.Left
	l.Font=Enum.Font.GothamBold
	l.Parent=p
	return l
end

