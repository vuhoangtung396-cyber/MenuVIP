local espOn=false
local rayOn=false
local flyOn=false
local lagOn=false
local flyVelocity

local function updateESP()
	for _,p in ipairs(Players:GetPlayers()) do
		if p~=LP and p.Character then
			local old=p.Character:FindFirstChild("TnhVN_ESP")
			if old then old:Destroy() end

			if espOn then
				local h=Instance.new("Highlight")
				h.Name="TnhVN_ESP"
				h.FillColor=Color3.fromRGB(0,170,255)
				h.OutlineColor=Color3.fromRGB(0,200,255)
				h.FillTransparency=.72
				h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
				h.Parent=p.Character
			end
		end
	end
end

espBtn.MouseButton1Click:Connect(function()
	espOn=not espOn
	espBtn.Text="Box người chơi : "..(espOn and "ON" or "OFF")
	updateESP()
end)

local lines={}

local function clearLines()
	for _,v in pairs(lines) do
		if v then v:Remove() end
	end
	lines={}
end

local function updateLines()
	clearLines()
	if not rayOn then return end

	for _,p in ipairs(Players:GetPlayers()) do
		if p~=LP and p.Character then
			local root=p.Character:FindFirstChild("HumanoidRootPart")
			if root then
				local line=Drawing and Drawing.new("Line")
				if line then
					line.Color=Color3.fromRGB(255,0,0)
					line.Thickness=2
					line.Transparency=1
					lines[p]=line
				end
			end
		end
	end
end

rayBtn.MouseButton1Click:Connect(function()
	rayOn=not rayOn
	rayBtn.Text="Vẽ tia : "..(rayOn and "ON" or "OFF")
	updateLines()
end)

flyBtn.MouseButton1Click:Connect(function()
	flyOn=not flyOn
	flyBtn.Text="Bật Fly : "..(flyOn and "ON" or "OFF")

	local root=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")

	if flyOn and root then
		flyVelocity=Instance.new("BodyVelocity")
		flyVelocity.MaxForce=Vector3.new(math.huge,math.huge,math.huge)
		flyVelocity.Velocity=Vector3.zero
		flyVelocity.Parent=root
	else
		if flyVelocity then
			flyVelocity:Destroy()
			flyVelocity=nil
		end
	end
end)

RunService.RenderStepped:Connect(function()
	if flyOn and flyVelocity then
		local h=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
		if h then
			flyVelocity.Velocity=h.MoveDirection*flySpeed
		end
	end

	if rayOn and Drawing then
		for p,l in pairs(lines) do
			local root=p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			local my=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")

			if root and my then
				local a,on1=workspace.CurrentCamera:WorldToViewportPoint(my.Position)
				local b,on2=workspace.CurrentCamera:WorldToViewportPoint(root.Position)
				l.Visible=on1 and on2
				l.From=Vector2.new(a.X,a.Y)
				l.To=Vector2.new(b.X,b.Y)
			else
				l.Visible=false
			end
		end
	end
end)

lagBtn.MouseButton1Click:Connect(function()
	lagOn=not lagOn
	lagBtn.Text="Tối ưu máy : "..(lagOn and "ON" or "OFF")

	if lagOn then
		Lighting.GlobalShadows=false
		Lighting.FogEnd=100000

		for _,v in ipairs(workspace:GetDescendants()) do
			if v:IsA("Clouds") then
				v.Enabled=false
			elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") then
				v.Enabled=false
			end
		end
	end
end)

