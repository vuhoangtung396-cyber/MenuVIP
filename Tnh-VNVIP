label(espPage,"ESP",5)
local espBtn=button(espPage,"Box người chơi : OFF",55)

local espOn=false

local function updateESP()
	for _,p in ipairs(Players:GetPlayers()) do
		if p~=LP and p.Character then
			local old=p.Character:FindFirstChild("TnhVN_ESP")
			if old then old:Destroy() end

			if espOn then
				local h=Instance.new("Highlight")
				h.Name="TnhVN_ESP"
				h.FillColor=Color3.fromRGB(0,170,255)
				h.OutlineColor=Color3.fromRGB(0,200,255)
				h.FillTransparency=.72
				h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
				h.Parent=p.Character
			end
		end
	end
end

espBtn.MouseButton1Click:Connect(function()
	espOn=not espOn
	espBtn.Text="Box người chơi : "..(espOn and "ON" or "OFF")
	updateESP()
end)

