flySlider.MouseButton1Down:Connect(function()
	local move
	move=UIS.InputChanged:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch then
			local x=math.clamp(i.Position.X-flySlider.AbsolutePosition.X,0,flySlider.AbsoluteSize.X)
			flySpeed=math.floor(1+(x/flySlider.AbsoluteSize.X)*449)
			flyBox.Text=tostring(flySpeed)
		end
	end)
	UIS.InputEnded:Wait()
	move:Disconnect()
end)

