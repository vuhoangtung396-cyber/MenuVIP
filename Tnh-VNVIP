local flySlider=Instance.new("TextButton")
flySlider.Size=UDim2.new(1,-10,0,14)
flySlider.Position=UDim2.fromOffset(5,205)
flySlider.BackgroundColor3=Color3.fromRGB(0,160,225)
flySlider.Text=""
flySlider.Parent=flyPage
corner(flySlider,7)

local flyOn=false
local flySpeed=50
local flyVelocity

flyBox.FocusLost:Connect(function()
	flySpeed=math.clamp(tonumber(flyBox.Text) or 50,1,450)
	flyBox.Text=tostring(flySpeed)
end)

flySlider.MouseButton1Down:Connect(function()
	local con
	con=UIS.InputChanged:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.MouseMovement
		or i.UserInputType==Enum.UserInputType.Touch then
			local x=math.clamp(
				i.Position.X-flySlider.AbsolutePosition.X,
				0,
				flySlider.AbsoluteSize.X
			)

			flySpeed=math.floor(1+(x/flySlider.AbsoluteSize.X)*449)
			flyBox.Text=tostring(flySpeed)
		end
	end)

	local ended
	ended=UIS.InputEnded:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.MouseButton1
		or i.UserInputType==Enum.UserInputType.Touch then
			con:Disconnect()
			ended:Disconnect()
		end
	end)
end)

flyBtn.MouseButton1Click:Connect(function()
	flyOn=not flyOn
	flyBtn.Text="Bật Fly : "..(flyOn and "ON" or "OFF")

	local root=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")

	if flyOn and root then
		flyVelocity=Instance.new("BodyVelocity")
		flyVelocity.MaxForce=Vector3.new(math.huge,math.huge,math.huge)
		flyVelocity.Velocity=Vector3.zero
		flyVelocity.Parent=root
	elseif flyVelocity then
		flyVelocity:Destroy()
		flyVelocity=nil
	end
end)

RunService.RenderStepped:Connect(function()
	if flyOn and flyVelocity then
		local hum=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			flyVelocity.Velocity=hum.MoveDirection*flySpeed
		end
	end
end)

